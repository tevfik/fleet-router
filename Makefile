# fleet — build, test and release helpers.   `make help` lists the targets.

GO       ?= go
PKG      := fleet
# a modified submodule (the engine build patches third_party/llama.cpp in place) is not a dirty tree
VERSION  ?= $(shell v=$$(git describe --tags --always 2>/dev/null || echo dev); git diff --quiet --ignore-submodules HEAD 2>/dev/null || v=$$v-dirty; echo $$v)
LDFLAGS  := -s -w -X main.version=$(VERSION)
# private builds (private.env, not in the public fleet) know where the fleet-engine packages are and update from the
# private repository; any other build updates from the public one
-include private.env
FLEET_UPDATE_REPO_BUILTIN ?= https://github.com/tevfik/fleet-router
ifneq ($(FLEET_ENGINE_REPO_BUILTIN),)
LDFLAGS  += -X github.com/tevfik/fleet-router/internal/update.EngineRepo=$(FLEET_ENGINE_REPO_BUILTIN)
endif
ifneq ($(FLEET_HUB_URL_BUILTIN),)
LDFLAGS  += -X github.com/tevfik/fleet-router/internal/config.DefaultHubURL=$(FLEET_HUB_URL_BUILTIN)
endif
ifneq ($(FLEET_UPDATE_REPO_BUILTIN),)
LDFLAGS  += -X github.com/tevfik/fleet-router/internal/update.Repo=$(FLEET_UPDATE_REPO_BUILTIN)
endif
DIST     := dist
# pure Go (no cgo): the binaries are static and cross-compile from any machine
export CGO_ENABLED = 0

.PHONY: help ext build build-amd64 build-arm64 build-all test race vet fmt check install install-system release clean selftest

# fleet-engine build targets (private.mk, not in the public fleet-router)
-include private.mk

help: ## list the targets
	@grep -hE '^[a-zA-Z0-9_-]+:.*## ' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  %-14s %s\n", $$1, $$2}'

build: ## build ./fleet for this machine
	$(GO) build -trimpath -ldflags '$(LDFLAGS)' -o fleet ./cmd/fleet

# Adapter modules live outside this repository (docs/extending.md). `make ext EXT_MOD=<module> EXT=<package> [EXT_DIR=<checkout>]`
# links their package(s) in with one generated blank-import file and a private ext.mod, so go.mod stays free of any adapter.
EXT_MOD ?=
EXT     ?= $(EXT_MOD)
EXT_DIR ?=
ext: ## build ./fleet with an adapter module linked in: EXT_MOD=example.com/fleet-mod EXT=example.com/fleet-mod/mymod [EXT_DIR=../fleet-mod]
	@test -n "$(EXT_MOD)" || { echo "usage: make ext EXT_MOD=<module path> [EXT=<package(s)>] [EXT_DIR=<local checkout>]"; exit 2; }
	cp go.mod ext.mod && cp go.sum ext.sum
	printf 'package main\n\n// generated by `make ext`; not committed\nimport (\n$(foreach p,$(EXT),\t_ "$(p)"\n))\n' > cmd/fleet/modules_ext.go
	$(GO) mod edit -modfile=ext.mod -require=$(EXT_MOD)@v0.0.0 $(if $(EXT_DIR),-replace=$(EXT_MOD)=$(EXT_DIR))
	GOFLAGS=-mod=mod $(GO) build -modfile=ext.mod -trimpath -ldflags '$(LDFLAGS)' -o fleet ./cmd/fleet

build-amd64: ## linux/amd64 binary → dist/fleet-linux-amd64
	GOOS=linux GOARCH=amd64 $(GO) build -trimpath -ldflags '$(LDFLAGS)' -o $(DIST)/fleet-linux-amd64 ./cmd/fleet

build-arm64: ## linux/arm64 binary → dist/fleet-linux-arm64
	GOOS=linux GOARCH=arm64 $(GO) build -trimpath -ldflags '$(LDFLAGS)' -o $(DIST)/fleet-linux-arm64 ./cmd/fleet

build-all: build-amd64 build-arm64 ## both linux targets

test: ## run the tests
	$(GO) test ./...

race: ## run the tests with the race detector
	CGO_ENABLED=1 $(GO) test -race ./...

vet: ## go vet
	$(GO) vet ./...

fmt: ## list files that need gofmt (non-empty output = needs formatting)
	@gofmt -l .

check: vet test ## vet + tests (what CI should run)
	@test -z "$$(gofmt -l .)" || { echo "gofmt needed:"; gofmt -l .; exit 1; }

install-system: build ## install to /usr/local/bin + systemd system service (run with sudo)
	sudo ./fleet setup all --system

install: build ## install to ~/.local/bin
	install -D -m 0755 fleet $(HOME)/.local/bin/fleet
	@if [ -f fleet-engine ]; then install -D -m 0755 fleet-engine $(HOME)/.local/bin/fleet-engine; echo "installed fleet-engine to $(HOME)/.local/bin/fleet-engine"; fi

release: clean build-all ## checksummed binaries for both architectures in dist/
	cd $(DIST) && sha256sum fleet-linux-* > SHA256SUMS
	@ls -l $(DIST)

selftest: build ## the fleet's models write tests for packages that have none (needs a daemon with tester/validator roles)
	./scripts/selftest.sh tests

clean: ## remove build output
	rm -rf $(DIST) fleet
